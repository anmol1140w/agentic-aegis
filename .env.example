# Copy to .env for local overrides. Shell variables take precedence.
AEGIS_MODEL_GENERAL=qwen3.5:9b
AEGIS_MODEL_VISION=qwen3-vl:8b
AEGIS_MODEL_CODER=qwen2.5-coder:7b
AEGIS_MODEL_LIGHTWEIGHT=Qwen2.5:1.5b
AEGIS_MODEL_EMBEDDING=nomic-embed-text:latest
AEGIS_OLLAMA_BASE_URL=http://localhost:11434
AEGIS_CONTAINER_IMAGE=python:3.12-slim
AEGIS_SANDBOX_BACKEND=process
AEGIS_ROUTING_MODE=shadow
AEGIS_REVIEWER_MODEL=qwen-general
# Bounded native Ollama streaming deadline and concise interactive output.
AEGIS_MODEL_TIMEOUT_SECONDS=90
AEGIS_GENERAL_MAX_TOKENS=256
SHOW_OLLAMA_THINKING=0
